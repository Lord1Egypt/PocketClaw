# Private Dart release-support output. Split debug info preserves the names and
# source metadata removed from the APK, so it must never enter Git or public
# release assets. The canonical local output lives under build/private-symbols/.
split-debug-info/
symbols/
*.symbols.zip

# Local configuration, credentials, and tooling
.env
.env.*
!.env.example
.tooling/
local.properties

# Logs and scratch output
*.log
*.tmp
*.bak
*.orig
*.rej

# IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store
__pycache__/

# Runtime state a Go test leaves beside the package it exercises when the agent
# workspace is unset. pkg/coresource deliberately excludes stray JSON from the
# Core fingerprint for the same reason; this keeps it out of the repository as
# well, so `git add -A` after a test run cannot commit one.
core/src/pkg/*/state/state.json
core/src/pkg/*/*/state/state.json
