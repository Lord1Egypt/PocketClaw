<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!--
      READ_PHONE_STATE is deliberately not declared. It served the Umeng device
      probe, and the Umeng SDK has been removed from PocketClaw entirely: no
      build variant packages or compiles against an analytics SDK, and nothing
      reads telephony state.
    -->

    <!--
      Advertising and attribution surface removed from the merged manifest.

      These four used to arrive with play-services-measurement, pulled in by the
      firebase_analytics plugin. H1.5 removed Firebase and Google Play Services
      from the build entirely — proprietary SDKs are disqualifying for official
      F-Droid, and F-Droid judges what is in the binary rather than what the
      code decides at runtime — so nothing contributes them any more and these
      four removals are currently no-ops.

      They are kept deliberately. They cost nothing, and if a future dependency
      ever reintroduces the advertising and attribution surface, it will arrive
      already stripped rather than quietly widening the permission set.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      FOREGROUND_SERVICE_DATA_SYNC and RECEIVE_BOOT_COMPLETED are deliberately
      not declared (PC-DEF-083). The first served flutter_background_service,
      configured with autoStart false and never started; the second served a
      BootReceiver whose auto_start preference no PocketClaw UI could ever set.
      Both plugins' components are gone with them, and release_gate.py keeps
      all three of these permissions out of the packaged manifest.
    -->

    <!-- Keeps the CPU awake while Core runs -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      No storage permission is declared (PC-DEF-077). The workspace is
      app-specific external storage, which needs none on any supported Android
      version; log export uses MediaStore, or the app's own Downloads folder
      below API 29; the Chat attachment picker and the legacy workspace import
      use system pickers that grant access to what the user chooses. All-files
      access, and the Settings redirect every cold launch used to make for it,
      are gone from the product.
    -->

    <application
        android:label="PocketClaw"
        android:name=".PocketClawApp"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              No VIEW/BROWSABLE filter. The Umeng debug/wake link that used to
              sit here was a web-reachable entry point into this exported
              activity for an SDK the APK did not contain (PC-DEF-024); it went
              first, and the SDK itself has since been removed. PocketClaw has
              no deep link.
            -->
        </activity>

        <!-- PocketClaw's foreground service, which runs the Go binaries -->
        <service
            android:name=".service.PocketClawService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The Dashboard runs in the system WebView, which otherwise reports
             its own usage metrics to Google from inside this process. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
