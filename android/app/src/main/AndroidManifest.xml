<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!--
      READ_PHONE_STATE is deliberately not declared here.

      It was requested app-wide for the Umeng device probe, which the default
      build does not package and never calls. A dangerous telephony permission
      in the manifest of a build that cannot use it costs the user a prompt and
      costs the listing a policy justification, for nothing. It cannot be made
      conditional in place: tools:node is resolved before manifest placeholders,
      so it takes no build-time value.

      An analytics build gets whatever the analytics SDK's own AAR manifest
      declares. If that SDK ever genuinely needs an app-level declaration, add it
      to the analytics build's own manifest, not to this one.
    -->

    <!--
      Advertising and attribution surface removed from the merged manifest.

      These four used to arrive with play-services-measurement, pulled in by the
      firebase_analytics plugin. H1.5 removed Firebase and Google Play Services
      from the build entirely — proprietary SDKs are disqualifying for official
      F-Droid, and F-Droid judges what is in the binary rather than what the
      code decides at runtime — so nothing contributes them any more and these
      four removals are currently no-ops.

      They are kept deliberately. They cost nothing, and if a future dependency
      ever reintroduces the advertising and attribution surface, it will arrive
      already stripped rather than quietly widening the permission set.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 保留 dataSync 兼容 flutter_background_service 插件 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Wake Lock 防止 CPU 休眠 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 通知权限 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 外部存储写入（Android 9 及以下） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 外部存储读取（Android 12 及以下） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 管理所有文件（Android 11+，写 Downloads 目录必需） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:label="PocketClaw"
        android:name=".PocketClawApp"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 友盟调试/唤起链接。仅匹配 appKey 对应 scheme，不绑定具体 debugkey 或 query。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${POCKETCLAW_UMENG_LINK_SCHEME}" />
            </intent-filter>
        </activity>

        <!-- PocketClaw 原生前台服务（运行 Go 二进制） -->
        <service
            android:name=".service.PocketClawService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Flutter Background Service 插件 -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- 开机自启广播接收器 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        
        <!-- 友盟统计配置 - 从 build.gradle 的 buildConfigField 读取 -->
        <meta-data
            android:name="UMENG_APPKEY"
            android:value="${POCKETCLAW_UMENG_APP_KEY}" />
        <meta-data
            android:name="UMENG_CHANNEL"
            android:value="${POCKETCLAW_UMENG_CHANNEL}" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
