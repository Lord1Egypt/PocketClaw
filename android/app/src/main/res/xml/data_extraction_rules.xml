<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later. Cloud backup and device-to-device transfer are separate
  decisions, and both directories are excluded from both.

  credentials/ is excluded from device transfer even though it never leaves the
  user's own devices: the Keystore key does not travel with it, so what would
  arrive is an undecryptable blob presented as a working connection.

  pocketclaw/ and picoclaw/ are Core's private state — config.json and
  .security.yml, the latter holding provider API keys and channel bot tokens in
  plaintext because Android onboarding declines credential encryption.
  App-private storage stops another app reading them; it does not stop a backup
  copying them off the device.

  pocketclaw/ is the canonical path, protected here before any code creates it.
  picoclaw/ is a LEGACY SECURITY EXCLUSION kept on purpose: an interrupted
  migration or a downgrade can leave secrets in the historical directory, and
  changing where PocketClaw writes must not make what is already there
  backup-eligible. It is retired deliberately in a later release, not swept up
  by namespace cleanup.

  Both are matched by name, and a rename would silently unprotect one. See
  android_backup_exclusion_test.dart, and the matching note in backup_rules.xml.

  RECHECK AFTER THE PRIVATE-DIRECTORY MIGRATION: the picoclaw/ lines are retired
  deliberately once the compatibility window closes, not before.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="credentials/" />
        <exclude domain="file" path="pocketclaw/" />
        <exclude domain="file" path="picoclaw/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="credentials/" />
        <exclude domain="file" path="pocketclaw/" />
        <exclude domain="file" path="picoclaw/" />
    </device-transfer>
</data-extraction-rules>
