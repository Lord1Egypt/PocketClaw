+
+describe("the web manifest identifies the product", () => {
+  const manifest = JSON.parse(
+    fsSync.readFileSync(`${PUBLIC}/site.webmanifest`, "utf8"),
+  ) as {
+    name: string
+    short_name: string
+    theme_color: string
+    background_color: string
