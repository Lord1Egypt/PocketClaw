 	homePath, _ := os.UserHomeDir()
-	if picoclawHome := os.Getenv(EnvHome); picoclawHome != "" {
-		homePath = picoclawHome
+	if homeOverride := canonicalenv.Getenv(EnvHome); homeOverride != "" {
+		homePath = homeOverride
