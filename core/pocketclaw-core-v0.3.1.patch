+// createOpenCodeProvider builds the provider for one OpenCode Zen/Go model
+// entry, selecting the transport from the model's protocol family.
+func createOpenCodeProvider(
+	protocol, modelID string,
+	cfg *config.ModelConfig,
+	userAgent string,
+) (LLMProvider, error) {
+	if cfg.APIKey() == "" {
+		return nil, fmt.Errorf("api_key is required for %q (model: %s)", protocol, cfg.Model)
+	}
+
+	apiBase := strings.TrimSpace(cfg.APIBase)
+	if apiBase == "" {
+		apiBase = getDefaultAPIBase(protocol)
+	}
+	if apiBase == "" {
+		return nil, fmt.Errorf("no API base configured for %q", protocol)
+	}
+
+	// The bare model ID is what the direct HTTP endpoints accept; the
+	// namespaced form belongs to the OpenCode CLI display layer only.
+	bareModel := NormalizeOpenCodeModelID(modelID)
+	routed, known := ClassifyOpenCodeModel(bareModel)
+	if !known {
+		logger.WarnCF(
+			"provider.opencode",
+			"Model is not in the known OpenCode routing table; attempting the fallback protocol",
+			map[string]any{
+				"provider":          protocol,
+				"model":             bareModel,
+				"fallback_protocol": string(routed),
+				"hint": "if the request fails with 404 or an unsupported-endpoint error, " +
+					"this model is likely served over a different OpenCode protocol",
+			},
+		)
+	}
+
+	switch routed {
+	case OpenCodeResponses:
+		return openairesponses.NewProvider(
+			cfg.APIKey(),
+			apiBase,
+			cfg.Proxy,
+			userAgent,
+			cfg.RequestTimeout,
+			cfg.CustomHeaders,
+		), nil
+
+	case OpenCodeMessages:
+		// OpenCode issues one account key for every surface, so the Messages
+		// endpoint is given both the Anthropic X-API-Key form and the bearer
+		// form used by the OpenAI surfaces.
+		return anthropicmessages.NewProviderWithTimeout(
+			cfg.APIKey(),
+			apiBase,
+			userAgent,
+			cfg.RequestTimeout,
+			anthropicmessages.WithBearerAuth(),
+		), nil
+
+	case OpenCodeChatCompletions:
+		provider := NewHTTPProviderWithMaxTokensFieldAndRequestTimeout(
+			cfg.APIKey(),
+			apiBase,
+			cfg.Proxy,
+			cfg.MaxTokensField,
+			userAgent,
+			cfg.RequestTimeout,
+			cfg.ExtraBody,
+			cfg.CustomHeaders,
+		)
+		provider.SetProviderName(protocol)
+		return provider, nil
+	}
+
+	return nil, fmt.Errorf("unsupported OpenCode routing %q for model %q", routed, bareModel)
+}
