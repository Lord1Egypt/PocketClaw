+func describeModelFetchNetworkError(fetchURL string, err error) error {
+	host := "provider"
+	if parsed, parseErr := url.Parse(fetchURL); parseErr == nil && parsed.Hostname() != "" {
+		host = parsed.Hostname()
+	}
+
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) {
+		return fmt.Errorf("DNS resolution failed for %s: %w", host, err)
+	}
+	if errors.Is(err, syscall.ECONNREFUSED) {
+		return fmt.Errorf("connection refused by %s: %w", host, err)
+	}
+	var urlErr *url.Error
+	if errors.Is(err, context.DeadlineExceeded) ||
+		(errors.As(err, &urlErr) && urlErr.Timeout()) {
+		return fmt.Errorf("connection timed out for %s: %w", host, err)
+	}
+	return fmt.Errorf("network request to %s failed: %w", host, err)
+}
+
+func describeModelFetchHTTPError(provider string, status int) error {
+	if status == http.StatusUnauthorized || status == http.StatusForbidden {
+		return fmt.Errorf("%s authentication failed (HTTP %d)", provider, status)
+	}
+	return fmt.Errorf("%s returned HTTP %d", provider, status)
+}
