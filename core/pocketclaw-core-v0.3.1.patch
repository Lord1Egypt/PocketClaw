+
+func TestTelegramSendFailureRetriesPlaceholderAsFinalDelivery(t *testing.T) {
+	msgBus := bus.NewMessageBus()
+	delivery := &lifecycleTestChannel{
+		editFailures: 1,
+		sendErr:      channels.ErrSendFailed,
