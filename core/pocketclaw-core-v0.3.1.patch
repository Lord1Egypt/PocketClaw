+    resolve(
+      process.cwd(),
+      "../../../../test/fixtures/user_visible_log_contract.json",
+    ),
+    "utf8",
+  ),
+) as LogContractCase[]
+
+describe("Core Web Console Logs page", () => {
+  beforeEach(() => {
+    gatewayLogState.logs = []
+  })
