+// isGeminiOpenAICompatibleBase reports whether a Gemini API base points at
+// Google's OpenAI-compatibility surface rather than the native v1beta API.
+func isGeminiOpenAICompatibleBase(apiBase string) bool {
+	return strings.HasSuffix(strings.TrimRight(strings.TrimSpace(apiBase), "/"), "/openai")
+}
+
+// fetchGeminiNativeModels lists models from Google's native generativelanguage
+// API, which authenticates with X-Goog-Api-Key and returns fully qualified
+// resource names such as "models/gemini-3-flash-preview".
+func fetchGeminiNativeModels(ctx context.Context, fetchURL, apiKey string) ([]upstreamModel, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, fetchURL, nil)
+	if err != nil {
+		return nil, err
+	}
+	if apiKey = strings.TrimSpace(apiKey); apiKey != "" {
+		req.Header.Set("X-Goog-Api-Key", apiKey)
+	}
+
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return nil, describeModelFetchNetworkError(fetchURL, err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, describeModelFetchHTTPError("Gemini", resp.StatusCode)
+	}
+
+	var parsed struct {
+		Models []struct {
+			Name string `json:"name"`
+		} `json:"models"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&parsed); err != nil {
+		return nil, fmt.Errorf("decode response: %w", err)
+	}
+
+	models := make([]upstreamModel, 0, len(parsed.Models))
+	for _, m := range parsed.Models {
+		id := strings.TrimPrefix(strings.TrimSpace(m.Name), "models/")
+		if id == "" {
+			continue
+		}
+		models = append(models, upstreamModel{ID: id})
+	}
+	return models, nil
+}
+
+func describeModelFetchNetworkError(fetchURL string, err error) error {
+	host := "provider"
+	if parsed, parseErr := url.Parse(fetchURL); parseErr == nil && parsed.Hostname() != "" {
+		host = parsed.Hostname()
+	}
+
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) {
+		return fmt.Errorf("DNS resolution failed for %s: %w", host, err)
+	}
+	if errors.Is(err, syscall.ECONNREFUSED) {
+		return fmt.Errorf("connection refused by %s: %w", host, err)
+	}
+	var urlErr *url.Error
+	if errors.Is(err, context.DeadlineExceeded) ||
+		(errors.As(err, &urlErr) && urlErr.Timeout()) {
+		return fmt.Errorf("connection timed out for %s: %w", host, err)
+	}
+	return fmt.Errorf("network request to %s failed: %w", host, err)
+}
+
+func describeModelFetchHTTPError(provider string, status int) error {
+	switch {
+	case status == http.StatusUnauthorized || status == http.StatusForbidden:
+		return fmt.Errorf("%s authentication failed (HTTP %d): check the API key", provider, status)
+	case status == http.StatusTooManyRequests:
+		return fmt.Errorf("%s rate limited the request (HTTP %d): try again shortly", provider, status)
+	case status == http.StatusNotFound:
+		return fmt.Errorf(
+			"%s has no model listing endpoint at this API base (HTTP %d): enter the model ID manually",
+			provider, status,
+		)
+	case status >= 500:
+		return fmt.Errorf("%s is unavailable (HTTP %d)", provider, status)
+	}
+	return fmt.Errorf("%s returned HTTP %d", provider, status)
+}
