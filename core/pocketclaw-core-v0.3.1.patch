+func TestOpenCodeProvidersAreFetchable(t *testing.T) {
+	for _, id := range []string{"opencode_zen", "opencode_go"} {
+		if !providers.IsModelProviderFetchable(id) {
+			t.Errorf("%s must support model discovery", id)
+		}
