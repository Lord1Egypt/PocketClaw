+func TestFetchUpstreamModels_PreservesCustomOpenAICompatibleBasePath(t *testing.T) {
+	var gotPath string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{"data":[{"id":"gemini-3.7-flash"}]}`)
+	}))
+	defer srv.Close()
+
+	models, err := fetchUpstreamModels(
+		t.Context(),
+		"openai",
+		srv.URL+"/v1beta/openai/",
+		"test-key",
+	)
+	if err != nil {
+		t.Fatalf("fetchUpstreamModels() error = %v", err)
+	}
+	if gotPath != "/v1beta/openai/models" {
+		t.Fatalf("request path = %q, want %q", gotPath, "/v1beta/openai/models")
+	}
+	if len(models) != 1 || models[0].ID != "gemini-3.7-flash" {
+		t.Fatalf("models = %#v, want the upstream model", models)
+	}
+}
