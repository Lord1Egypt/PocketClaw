# Pinned toolchains for PocketClaw's native payloads. Sourced, never executed.
#
# Every value here decides payload bytes, and those bytes are not free to
# drift: Core embeds the SHA-256 of each Managed Runtime payload
# (core/src/pkg/pcruntime/manifest.json) and rejects a payload that does not
# match, so a rebuild with any other compiler produces a tool that resolves as
# corrupt on every device. The recipes select exactly these versions and fail
# when they cannot, rather than accepting whatever toolchain the host offers.
#
# Changing one means rebuilding the payloads it touches, recording their new
# checksums in the catalog, and rebuilding and restaging Core.

# Android NDK r28c: the C/C++ payloads, and llvm-strip for Core.
POCKETCLAW_NDK_VERSION=28.2.13676358

# Core (libpocketclaw.so, libpocketclaw-web.so). core/src/go.mod asks for it.
POCKETCLAW_CORE_GO_TOOLCHAIN=go1.25.11

# gh 2.82.1's own go.mod selects this; pinned so a newer host Go cannot win.
POCKETCLAW_GH_GO_TOOLCHAIN=go1.24.6

# ripgrep. The committed payload's .comment section records this rustc.
POCKETCLAW_RUST_TOOLCHAIN=1.94.1
