# PocketClaw Telegram onboarding service — configuration template.
#
# Copy to .env and fill in real values. NEVER commit a filled-in .env: the
# manager bot token is a server secret and must never reach the APK, the
# repository, or a log.

# The PocketClaw manager bot's token, from BotFather.
# Bot Management Mode must be enabled for this bot; see README.md.
TELEGRAM_MANAGER_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_MANAGER_BOT_TOKEN

# The manager bot's public @username, without the @.
# This is public: it appears in every managed-bot creation link.
TELEGRAM_MANAGER_BOT_USERNAME=PocketClawSetupBot

# The HTTPS base URL phones use to reach this service. Not read by the server
# itself; it is the value you configure in the PocketClaw app, recorded here so
# a deployment keeps all of its endpoints in one place.
PUBLIC_ONBOARDING_BASE_URL=https://onboarding.example.org

# Optional. Address the HTTP server binds to.
LISTEN_ADDR=:8080

# Optional. How long a pairing session lives before it is discarded. Keep this
# short: it bounds how long any token material can exist in memory.
PAIRING_TTL_SECONDS=600

# Optional. Per-client rate limit on pairing creation.
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_SECOND=0.2

# Optional. Set to "true" ONLY when running behind a reverse proxy that
# overwrites X-Forwarded-For. Otherwise clients can forge it and evade the
# rate limit.
TRUST_PROXY_HEADER=false
